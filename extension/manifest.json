{
  "manifest_version": 3,
  "name": "WhatsApp Tools",
  "version": "0.1.0",
  "description": "WhatsApp Web sohbetlerinizi medyasıyla birlikte HTML, TXT, CSV ve JSON olarak yerel diske aktarır. Hiçbir veriyi dışarı göndermez.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsApp Tools panelini aç/kapat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "WhatsApp Tools panelini aç/kapat"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["bridge.js"],
      "css": ["page/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "page/util.js",
        "page/zip.js",
        "page/sinks.js",
        "page/wa.js",
        "page/formats.js",
        "page/exporter.js",
        "page/panel.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
